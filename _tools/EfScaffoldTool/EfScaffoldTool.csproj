<Project Sdk="Microsoft.NET.Sdk">

	<!--
		Standalone host for the "dotnet ef dbcontext scaffold" design-time tooling. It exists purely so that
		Microsoft.EntityFrameworkCore.Sqlite + Microsoft.EntityFrameworkCore.Design never have to be
		referenced by TightWiki.Data.EfCore, which must stay provider-agnostic (see Database-Providers-Plan.md,
		chapters 4.2.1/5/9 - no SQLite package may reach a provider-agnostic or non-SQLite build).

		Invoked exclusively by Generate-EfMigrations.ps1 (repo root) via "dotnet ef dbcontext scaffold",
		pointed at this project, once per database file, writing generated entities into
		TightWiki.Data.EfCore\_Scaffold\<Schema>\ (excluded from that project's compilation).

		Deliberately NOT part of TightWiki.sln and has no ProjectReference to TightWiki.Data.EfCore or
		anything else in the solution, so it cannot affect a normal build/publish of any other project.
	-->

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

</Project>
