<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

	<!--
		DataProvider selects which database driver this build targets, mirroring TightWiki.csproj (see that
		project's comment for the full rationale). "Sqlite" is the default when -p:DataProvider= isn't passed.
	-->
	<PropertyGroup>
		<DataProvider Condition="'$(DataProvider)'==''">Sqlite</DataProvider>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DataProvider)'=='Sqlite'">
		<DefineConstants>$(DefineConstants);SQLITE_PROVIDER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DataProvider)'=='SqlServer'">
		<DefineConstants>$(DefineConstants);SQLSERVER_PROVIDER</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(DataProvider)'=='Postgres'">
		<DefineConstants>$(DefineConstants);POSTGRES_PROVIDER</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" Condition="'$(DataProvider)'=='Sqlite'" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" Condition="'$(DataProvider)'=='Sqlite'" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
		<PackageReference Include="xunit.abstractions" Version="2.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TightWiki.Engine\TightWiki.Engine.csproj" />
		<ProjectReference Include="..\TightWiki.Plugin.Default\TightWiki.Plugin.Default.csproj" />
		<ProjectReference Include="..\TightWiki.Repository\TightWiki.Repository.csproj" Condition="'$(DataProvider)'=='Sqlite'" />
		<ProjectReference Include="..\TightWiki.Data.EfCore.SqlServer\TightWiki.Data.EfCore.SqlServer.csproj" Condition="'$(DataProvider)'=='SqlServer'" />
		<ProjectReference Include="..\TightWiki.Data.EfCore.Postgres\TightWiki.Data.EfCore.Postgres.csproj" Condition="'$(DataProvider)'=='Postgres'" />
	</ItemGroup>

	<!--
		appsettings.Development.SqlServer.json/.Postgres.json hold the ConnectionStrings:TightWikiEfCore override
		MockWikiEngineArtifacts reads when built with -p:DataProvider=SqlServer/Postgres (see that file's
		SQLSERVER_PROVIDER/POSTGRES_PROVIDER branches). Marked CopyToOutputDirectory so they land next to this
		library's own bin output as well as the output of every project that references it (TightWiki.Tests,
		TightWiki.Test.CaseGenerator) - same propagation TightWiki.Tests already relies on for its own
		appsettings*.json (see TightWiki.Tests.csproj). Included unconditionally (not gated on DataProvider) so a
		Sqlite build doesn't need a restore to pick them up again once DataProvider is switched - Program.cs's own
		appsettings.Development.SqlServer.json/.Postgres.json follow the same unconditional-presence pattern.
	-->
	<ItemGroup>
		<Content Include="appsettings.Development.SqlServer.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="appsettings.Development.Postgres.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
