<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2.38.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<!--
			Relational is the shared abstraction that every relational provider (SqlServer, Npgsql, Sqlite, ...)
			builds on top of - it is what brings Fluent APIs like ToTable(schema:), UseCollation(...) and
			HasDefaultValue(...) into scope. It has no dependency on any specific provider (in particular, no
			SQLite dependency) and is safe to reference directly from this provider-agnostic project.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
		<!--
			Needed by EfPageRepository's search-token helpers (GetFuzzyPageSearchTokens/GetExactPageSearchTokens/
			ParsePageTokens's ComputeParsedPageTokens) for the same DoubleMetaphone phonetic-encoding extension
			method the SQLite reference (TightWiki.Repository.PageRepository) uses - fuzzy/exact search scoring
			runs in C#, not SQL, on both sides (Database-Providers-Plan.md phase 2b.5).
		-->
		<PackageReference Include="DuoVia.FuzzyStrings" Version="2.1.0" />
	</ItemGroup>

	<!--
		Needed for the shared ITwXRepository interfaces / Tw* models (e.g. ITwDefaultsRepository, TwDefaultEmoji)
		that EfDefaultsRepository (Seeding\EfDefaultsRepository.cs) implements/returns - see
		Database-Providers-Plan.md chapter 4.6b. TightWiki.Plugin has no SQLite/Dapper PackageReference, so this
		ProjectReference brings in no SQLite dependency, transitive or otherwise.
	-->
	<ItemGroup>
		<ProjectReference Include="..\TightWiki.Plugin\TightWiki.Plugin.csproj" />
	</ItemGroup>

	<!--
		Needed by the ITwXRepository LINQ implementations under Repositories\ (e.g. EfConfigurationRepository) for
		SecurityUtility/Constants.CRYPTOCHECK (encrypted configuration values, the crypto check) and MemCache
		(matching the SQLite reference's caching behavior), plus ApplicationDbContext (ASP.NET Core Identity,
		Database-Providers-Plan.md chapter 4.1.1) for the one cross-context query
		(EfConfigurationRepository.GetWikiDatabaseMetrics) that needs a row count from AspNetUsers. Verified clean
		for this purpose - TightWiki.Library only depends on TightWiki.Plugin (no SQLite/Dapper PackageReference,
		no other ProjectReference), so this pulls in no SQLite, keeping chapter 9's "Definice hotovo" constraint
		intact. Same reasoning TightWiki.Data.EfCore.SqlServer's own ProjectReference to TightWiki.Library already
		relies on.
	-->
	<ItemGroup>
		<ProjectReference Include="..\TightWiki.Library\TightWiki.Library.csproj" />
	</ItemGroup>

	<!--
		_Scaffold\ is a reference-only artifact regenerated by Generate-EfMigrations.ps1 (repo root) from the
		live SQLite schema (see Database-Providers-Plan.md, chapter 5). It is a raw "dotnet ef dbcontext
		scaffold" dump, not hand-tuned production code, and must never be compiled as part of this project.
	-->
	<ItemGroup>
		<Compile Remove="_Scaffold\**\*.cs" />
	</ItemGroup>

</Project>
