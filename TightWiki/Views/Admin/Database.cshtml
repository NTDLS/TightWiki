@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.ViewModels.Admin
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model DatabaseViewModel
@{
    Layout = "_Layout";
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">
            @Localize("Database")
        </h3>
        <div class="text-muted">
            @Localize("Various utilities to assist in management of the SQLite database.")
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
        @TwConfirmActionHelper.GenerateSafeButton(
            WikiConfiguration.BasePath,
            Localize("This will create a backup of all of the databases. This could take some time! Continue?"),
            Localize("Back Up Databases"),
            "/Admin/DatabaseBackups/Create",
            Context.Request.Path.Value,
            @class: "btn btn-primary btn-sm d-inline-flex align-items-center")

        <a class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center"
           href="@WikiConfiguration.BasePath/Admin/DatabaseBackups">
            <i class="bi bi-archive me-1"></i>@Localize("View Backups")
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <span class="fw-semibold">
            <i class="bi bi-database me-2"></i>@Localize("Database Utilities")
        </span>
    </div>

    @if (Model.Info.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">
                            @Localize("Name")
                        </th>
                        <th scope="col" class="text-nowrap">
                            @Localize("Version")
                        </th>
                        <th scope="col" class="text-nowrap">
                            @Localize("Size")
                        </th>
                        <th scope="col">
                            @Localize("Action")
                        </th>
                        <th scope="col">
                            @Localize("Restore")
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var info in Model.Info)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @info.Name
                            </td>

                            <td class="text-nowrap text-muted">
                                @info.Version
                            </td>

                            <td class="text-nowrap">
                                @NTDLS.Helpers.Formatters.FileSize((long)info.DatabaseSize)
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    @TwConfirmActionHelper.GenerateSafeButton(
                                        WikiConfiguration.BasePath,
                                        Localize("This will optimize the database indexes and structure. Continue?"),
                                        Localize("Optimize"),
                                        $"/Admin/Database/Optimize/{info.Name}",
                                        Context.Request.Path.Value,
                                        @class: "btn btn-primary btn-sm d-inline-flex align-items-center")

                                    @TwConfirmActionHelper.GenerateSafeButton(
                                        WikiConfiguration.BasePath,
                                        Localize("This will remove empty space from the database, which can free space if a lot of data has been deleted. Continue?"),
                                        Localize("Vacuum"),
                                        $"/Admin/Database/Vacuum/{info.Name}",
                                        Context.Request.Path.Value,
                                        @class: "btn btn-primary btn-sm d-inline-flex align-items-center")

                                    @TwConfirmActionHelper.GenerateSafeButton(
                                        WikiConfiguration.BasePath,
                                        Localize("This will check the database integrity and validate all foreign keys. Continue?"),
                                        Localize("Verify"),
                                        $"/Admin/Database/Verify/{info.Name}",
                                        Context.Request.Path.Value,
                                        @class: "btn btn-primary btn-sm d-inline-flex align-items-center")
                                </div>
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    @if (info.Name == "Config")
                                    {
                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will merge in all default configuration, but will not overwrite any of your currently configured settings. Continue?"),
                                            Localize("Configuration"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.Configurations}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")

                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will restore all default themes, overwriting any customizations you may have made in the database. Continue?"),
                                            Localize("Themes"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.Themes}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")
                                    }
                                    else if (info.Name == "Pages")
                                    {
                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will restore all Wiki Help namespace pages. Continue?"),
                                            Localize("Wiki Help Pages"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.HelpPages}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")

                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will restore all built-in namespace pages, overwriting any customizations you may have made. Continue?"),
                                            Localize("Built-in Pages"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.BuiltinPages}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")

                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will restore all Include namespace pages. Continue?"),
                                            Localize("Include Pages"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.IncludePages}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")

                                        @TwConfirmActionHelper.GenerateWarnButton(
                                            WikiConfiguration.BasePath,
                                            Localize("This will restore all Feature Templates, overwriting any customizations you may have made. Continue?"),
                                            Localize("Feature Templates"),
                                            $"/Admin/Database/Restore/{TwDefaultDataType.FeatureTemplates}",
                                            Context.Request.Path.Value,
                                            @class: "btn btn-warning text-dark btn-sm d-inline-flex align-items-center")
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="card-body text-muted">
            <i class="bi bi-database-x me-2"></i>
            @Localize("No database information is available.")
        </div>
    }
</div>