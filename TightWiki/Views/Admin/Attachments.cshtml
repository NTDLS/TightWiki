@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.Admin
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model AttachmentsViewModel
@{
    Layout = "_Layout";
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
    var returnUrl = Context.Request.Path.Value + Context.Request.QueryString.Value;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">
            @Localizer["Attachments"]
        </h3>
        <div class="text-muted">
            @Localizer["All file attachments across all pages, largest first. Orphaned attachments are not used by any page revision."]
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">
            <i class="bi bi-paperclip me-2"></i>@Localizer["Attachment Administration"]
        </span>

        <div class="d-flex flex-wrap gap-3 text-muted small">
            <span>@Localizer["Total"]: <span class="fw-semibold">@Model.Totals.TotalCount.ToString("N0") (@NTDLS.Helpers.Formatters.FileSize(Model.Totals.TotalSize))</span></span>
            <span>@Localizer["Orphaned"]: <span class="fw-semibold">@Model.Totals.OrphanedCount.ToString("N0") (@NTDLS.Helpers.Formatters.FileSize(Model.Totals.OrphanedSize))</span></span>
        </div>

        @if (Model.Totals.OrphanedCount > 0)
        {
            @TwConfirmActionHelper.GenerateDangerButton(
                WikiConfiguration.BasePath,
                Localizer["This will permanently purge all orphaned page attachments. Continue?"].Value,
                Localizer["Purge Orphaned Attachments"].Value,
                "/Admin/PurgeOrphanedAttachments",
                Context.Request.Path.Value,
                @class: "btn btn-danger btn-sm d-inline-flex align-items-center")
        }
    </div>

    <div class="card-body">
        @using (Html.BeginForm(FormMethod.Get))
        {
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md">
                    @Html.TextBoxFor(x => x.SearchString, new
                    {
                        @class = "form-control",
                        placeholder = Localizer["Search by file name, page, namespace or type..."].Value
                    })
                </div>
                <div class="col-12 col-md-auto">
                    <select name="Status" class="form-select">
                        <option value="" selected="@(string.IsNullOrEmpty(Model.Status))">@Localizer["All Attachments"]</option>
                        <option value="orphaned" selected="@(Model.Status.Equals("orphaned", StringComparison.InvariantCultureIgnoreCase))">@Localizer["Orphaned Only"]</option>
                        <option value="inuse" selected="@(Model.Status.Equals("inuse", StringComparison.InvariantCultureIgnoreCase))">@Localizer["In Use Only"]</option>
                    </select>
                </div>
                <div class="col-12 col-md-auto">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>@Localizer["Search"]
                    </button>
                </div>
            </div>
        }
    </div>
</div>

@if (Model.Files.Count > 0)
{
    <div class="card shadow-sm">
        <div class="card-body pb-0">
            @TwPageSelectorGenerator.Generate(Context.Request.QueryString, Model.PaginationPageCount, @class: "mb-3", localizer: Localizer)
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "File")">
                                @Localizer["File"]
                            </a>
                        </th>
                        <th scope="col">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Page")">
                                @Localizer["Page"]
                            </a>
                        </th>
                        <th scope="col" class="text-nowrap">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Type")">
                                @Localizer["Type"]
                            </a>
                        </th>
                        <th scope="col" class="text-end text-nowrap" style="width: 1%;">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Size")">
                                @Localizer["Size"]
                            </a>
                        </th>
                        <th scope="col" class="text-nowrap" style="width: 1%;">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Revision")">
                                @Localizer["Revision"]
                            </a>
                        </th>
                        <th scope="col" class="text-nowrap" style="width: 1%;">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Created")">
                                @Localizer["Created"]
                            </a>
                        </th>
                        <th scope="col" class="text-nowrap" style="width: 1%;">
                            <a class="link-dark text-decoration-none"
                               href="?@TwQueryStringConverter.OrderHelper(sessionState, "Usage")">
                                @Localizer["Usage"]
                            </a>
                        </th>
                        <th scope="col" class="text-nowrap" style="width: 1%;">
                            @Localizer["Action"]
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Files)
                    {
                        <tr>
                            <td>
                                <a class="text-decoration-none fw-semibold"
                                   href="@WikiConfiguration.BasePath/File/Binary/@p.PageNavigation/@p.FileNavigation/@p.FileRevision">
                                    @p.FileName
                                </a>
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(p.Namespace))
                                {
                                    <a class="text-decoration-none text-muted"
                                       href="@WikiConfiguration.BasePath/Admin/Namespace/@p.Namespace">
                                        @p.Namespace
                                    </a>
                                    <span class="text-muted"> :: </span>
                                }

                                <a class="text-decoration-none"
                                   href="@WikiConfiguration.BasePath/@p.PageNavigation">
                                    @p.PageTitle
                                </a>
                            </td>

                            <td class="text-nowrap text-muted">
                                @p.ContentType
                            </td>

                            <td class="text-end text-nowrap">
                                @NTDLS.Helpers.Formatters.FileSize(p.Size)
                            </td>

                            <td class="text-nowrap text-muted">
                                @p.FileRevision
                            </td>

                            <td class="text-nowrap text-muted">
                                @p.CreatedDate.ToShortDateString()
                            </td>

                            <td class="text-nowrap">
                                @if (p.IsOrphaned)
                                {
                                    <span class="badge text-bg-danger">@Localizer["Orphaned"]</span>
                                }
                                else if (p.CurrentPageRevisionCount > 0)
                                {
                                    <span class="badge text-bg-success">@Localizer["Current"]</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@Localizer["Previous Revisions"]</span>
                                }
                            </td>

                            <td class="text-nowrap">
                                <div class="d-flex gap-2">
                                    @TwConfirmActionHelper.GenerateDangerButton(
                                        WikiConfiguration.BasePath,
                                        p.IsOrphaned
                                            ? Localizer["This will permanently delete the specified attachment. Continue?"].Value
                                            : Localizer["This attachment is in use by one or more page revisions. Deleting it will permanently remove it from those pages. Continue?"].Value,
                                        Localizer["Delete"].Value,
                                        $"/Admin/DeleteAttachment/{p.PageFileId}/{p.FileRevision}",
                                        returnUrl,
                                        @class: "btn btn-outline-danger btn-sm d-inline-flex align-items-center")
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card-body pt-3">
            @TwPageSelectorGenerator.Generate(Context.Request.QueryString, Model.PaginationPageCount, localizer: Localizer)
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-muted">
            <i class="bi bi-check-circle me-2"></i>
            @Localizer["No attachments were found."]
        </div>
    </div>
}
