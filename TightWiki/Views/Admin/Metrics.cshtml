@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Library.Caching
@using TightWiki.Plugin.Interfaces
@using TightWiki.ViewModels.Admin
@using System.Globalization
@using System.Runtime.InteropServices;
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model MetricsViewModel
@{
    Layout = "_Layout";
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">
            @Localize("Metrics")
        </h3>
        <div class="text-muted">
            <a href="http://NetworkDLS.com/" class="text-decoration-none">NetworkDLS</a>
            <a href="http://TightWiki.com/" class="text-decoration-none">TightWiki</a>
            @Localize("version") @Model.ApplicationVersion
        </div>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="fw-semibold">
            <i class="bi bi-speedometer2 me-2"></i>@Localize("System Metrics")
        </span>

        @Html.Raw(TwConfirmActionHelper.GenerateWarnButton(
            WikiConfiguration.BasePath,
            Localize("Flushing the memory cache will cause any cached items to be dropped and require database hits as pages are requested. Continue?"),
            Localize("Purge Memory Cache"),
            "/Admin/PurgeMemoryCache",
            Context.Request.Path.Value))
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <span class="fw-semibold">
            <i class="bi bi-pc-display me-2"></i>@Localize("Environment")
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <tbody>
                <tr>
                    <th scope="row">@Localize("Operating System")</th>
                    <td>@RuntimeInformation.OSDescription</td>
                    <th scope="row">@Localize("OS Architecture")</th>
                    <td>@RuntimeInformation.OSArchitecture</td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Process Architecture")</th>
                    <td>@RuntimeInformation.ProcessArchitecture</td>
                    <th scope="row">@Localize("Framework Version")</th>
                    <td>@RuntimeInformation.FrameworkDescription</td>
                </tr>
                <tr>
                    <th scope="row">Culture</th>
                    <td>@CultureInfo.CurrentCulture</td>
                    <th scope="row">UI Culture</th>
                    <td>@CultureInfo.CurrentUICulture</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header">
        <span class="fw-semibold">
            <i class="bi bi-graph-up me-2"></i>@Localize("General")
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <tbody>
                <tr>
                    <th scope="row">@Localize("Pages")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/Admin/Pages">@Model.Metrics.Pages.ToString("N0")</a></td>
                    <th scope="row">@Localize("Page Revisions")</th>
                    <td>@Model.Metrics.PageRevisions.ToString("N0")</td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Page Attachments")</th>
                    <td>@Model.Metrics.PageAttachments.ToString("N0")</td>
                    <th scope="row">@Localize("Inter-Page Links")</th>
                    <td>@Model.Metrics.IntraLinks.ToString("N0")</td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Page Tags")</th>
                    <td>@Model.Metrics.PageTags.ToString("N0")</td>
                    <th scope="row">@Localize("Page Attachment Revisions")</th>
                    <td>@Model.Metrics.PageAttachmentRevisions.ToString("N0")</td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Page Search Tokens")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/Page/Search">@Model.Metrics.PageSearchTokens.ToString("N0")</a></td>
                    <th scope="row">@Localize("Namespaces")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/Admin/Namespaces">@Model.Metrics.Namespaces.ToString("N0")</a></td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Users")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/AdminSecurity/Accounts">@Model.Metrics.Users.ToString("N0")</a></td>
                    <th scope="row">@Localize("Profiles")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/AdminSecurity/Accounts">@Model.Metrics.Profiles.ToString("N0")</a></td>
                </tr>
                <tr>
                    <th scope="row">@Localize("Exceptions")</th>
                    <td><a class="text-decoration-none" href="@WikiConfiguration.BasePath/Admin/Eventlog/Error">@Model.Exceptions.ToString("N0")</a></td>
                    <th scope="row">&nbsp;</th>
                    <td>&nbsp;</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header">
        <span class="fw-semibold">
            <i class="bi bi-memory me-2"></i>@Localize("Cache")
        </span>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col" class="text-end">@Localize("Items")</th>
                    <th scope="col" class="text-end">@Localize("Puts")</th>
                    <th scope="col" class="text-end">@Localize("Gets")</th>
                    <th scope="col" class="text-end">@Localize("Hits")</th>
                    <th scope="col" class="text-end">@Localize("Misses")</th>
                    <th scope="col" class="text-end">@Localize("Limit(MB)")</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-end">@MemCache.CacheItemCount.ToString("N0")</td>
                    <td class="text-end">@MemCache.CacheSets.ToString("N0")</td>
                    <td class="text-end">@MemCache.CacheGets.ToString("N0")</td>
                    <td class="text-end">@MemCache.CacheHits.ToString("N0")</td>
                    <td class="text-end">@MemCache.CacheMisses.ToString("N0")</td>
                    <td class="text-end">@NTDLS.Helpers.Formatters.FileSize((long)MemCache.CacheMemoryLimit)</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>