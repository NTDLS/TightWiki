@using System.Globalization
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using TightWiki
@using TightWiki.Library
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Interfaces.Repository
@using static TightWiki.Plugin.TwConstants
@inject ITwSharedLocalizationText Localizer
@inject ITwEngine TightEngine
@inject TwConfiguration WikiConfiguration
@inject ITwUsersRepository UsersRepository
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion

@{
    var sessionState = ViewData["SessionState"] as TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");

    string navBarClass = "navbar navbar-expand-lg bg-body-tertiary border-bottom shadow-sm";
    //The header (not the navbar inside it) is what sticks, a sticky element can only move within its parent.
    string headerClass = WikiConfiguration.FixedMenuPosition ? "sticky-top" : "";
    var isPageProtected = sessionState.PageInstructions.Contains(TwInstruction.Protect);
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(sessionState.PageTitle ?? sessionState.Page.Name)</title>

    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32.png")">
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16.png")">

    @if (!string.IsNullOrWhiteSpace(WikiConfiguration.HTMLHeader))
    {
        @Html.Raw(WikiConfiguration.HTMLHeader)
    }

    @if (WikiConfiguration.IncludeWikiDescriptionInMeta)
    {
        <meta name="description" content="@sessionState.Page.Description">
    }

    @if (WikiConfiguration.IncludeWikiTagsInMeta)
    {
        <meta name="keywords" content="@sessionState.PageTags">
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.7/css/bootstrap.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/themes/base/jquery-ui.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/css/tabulator.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    @* Only applied while the dark theme is in effect, theme.js switches it on and off. *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/css/tabulator_midnight.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" data-theme-only="dark" media="not all" />
    <link rel="stylesheet" href="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/syntax/styles/hljs.css"))" />

    @* The version hash makes browsers fetch the stylesheet again whenever it changes. *@
    <link rel="stylesheet" href="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/css/base.css"))" />

    @* Applies the light/dark theme, this must come after the stylesheets and before the page is painted. *@
    <script src="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/theme.js"))"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/jquery-ui.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.7/js/bootstrap.bundle.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/js/tabulator.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        window.twText = @Json.Serialize(new
        {
            confirmTitle = Localize("Are you sure?"),
            yes = Localize("Yes"),
            no = Localize("No"),
            close = Localize("Close")
        });
    </script>
    <script src="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/site.js"))"></script>

    @RenderSection("Scripts", required: false)
</head>

<body>
    <header class="@headerClass">
        <nav class="@navBarClass">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="@WikiConfiguration.BasePath/">
                    <span class="site-branding d-inline-flex align-items-center gap-2">
                        <img src="@Url.Content(WikiConfiguration.BrandImageSmall)"
                             alt="@WikiConfiguration.Name"
                             style="max-height: 28px;" />
                        <span>@WikiConfiguration.Name</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">

                        @foreach (var item in WikiConfiguration.MenuItems)
                        {
                            if (item.Link.StartsWith("http://", StringComparison.InvariantCultureIgnoreCase) ||
                                item.Link.StartsWith("https://", StringComparison.InvariantCultureIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@item.Link" target="_blank" rel="noopener">
                                        @Localizer[item.Name]
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@WikiConfiguration.BasePath@item.Link">
                                        @Localizer[item.Name]
                                    </a>
                                </li>
                            }
                        }

                        @if (await sessionState.HoldsPermission(TwPermission.Create)
                                                    || (sessionState.ShouldCreatePage && await sessionState.HoldsPermission(TwPermission.Create))
                                                    || (sessionState.Page.Exists && await sessionState.HoldsPermission([TwPermission.Edit, TwPermission.Moderate, TwPermission.Delete])))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="pageMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localize("Page")
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="pageMenuDropdown">
                                    @{
                                        bool canRead = await sessionState.HoldsPermission(TwPermission.Read);
                                        bool canCreate = await sessionState.HoldsPermission(TwPermission.Create);
                                        bool canEdit = !sessionState.Page.IsHistoricalVersion
                                            && ((!isPageProtected && await sessionState.HoldsPermission(TwPermission.Edit))
                                                || (isPageProtected && await sessionState.HoldsPermission(TwPermission.Moderate)));
                                        //Protected pages can not be deleted until their protection is removed.
                                        bool canDelete = !sessionState.Page.IsHistoricalVersion && !isPageProtected
                                            && await sessionState.HoldsPermission(TwPermission.Delete);
                                        bool canRevert = sessionState.Page.IsHistoricalVersion && await sessionState.HoldsPermission(TwPermission.Moderate);
                                        string pageUrl = $"{WikiConfiguration.BasePath}/{sessionState.PageNavigation}";
                                    }

                                    @if (sessionState.Page.Exists)
                                    {
                                        if (canRead)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl">@Localize("View")</a></li>
                                        }
                                        if (canEdit)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/Edit">@Localize("Edit")</a></li>
                                        }
                                        if (canRead && WikiConfiguration.EnablePageComments)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/Comments">@Localize("Comments")</a></li>
                                        }
                                        if (canRead)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/Revisions">@Localize("Revisions")</a></li>
                                            <li><a class="dropdown-item" href="@pageUrl/Export">@Localize("Export")</a></li>
                                        }
                                        if (canCreate)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/Refresh">@Localize("Refresh")</a></li>
                                        }
                                        if (canRevert)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/revert/@sessionState.Page.Revision">@Localize("Revert to revision {0}", sessionState.Page.Revision)</a></li>
                                        }
                                    }

                                    @if (canCreate)
                                    {
                                        if (sessionState.Page.Exists)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        if (sessionState.ShouldCreatePage)
                                        {
                                            <li><a class="dropdown-item" href="@pageUrl/Create">@Localize("Create \"{0}\"", sessionState.PageNavigation)</a></li>
                                        }
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Page/Create">@Localize("Create new page")</a></li>
                                    }

                                    @if (sessionState.Page.Exists && canDelete)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="@pageUrl/Delete">@Localize("Delete this page")</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (sessionState.IsAuthenticated && await sessionState.HoldsPermission(TwPermission.Moderate))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localize("Admin")
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenuDropdown">
                                    @if (sessionState.IsAdministrator)
                                    {
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/AdminSecurity/Accounts">@Localize("Accounts")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/AdminSecurity/Roles">@Localize("Roles")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Config">@Localize("Configuration")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Plugins">@Localize("Plugins")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Emojis">@Localize("Emojis")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/MenuItems">@Localize("Site Menu")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/PageStatistics">@Localize("Page Statistics")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Database">@Localize("Database")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/EventLog">@Localize("Event Log")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Metrics">@Localize("Metrics")</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Attachments">@Localize("Attachments")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/DeletedPages">@Localize("Deleted Pages")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/MissingPages">@Localize("Missing Pages")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Moderate">@Localize("Moderate")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Namespaces">@Localize("Namespaces")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/OrphanedPageAttachments">@Localize("Orphaned Attachments")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Pages">@Localize("Pages")</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/DeletedPages">@Localize("Deleted Pages")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/MissingPages">@Localize("Missing Pages")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Moderate">@Localize("Moderate")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Namespaces">@Localize("Namespaces")</a></li>
                                        <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Admin/Pages">@Localize("Pages")</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (sessionState.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="myMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localize("My")
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="myMenuDropdown">
                                    <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Profile/My">@Localize("Profile")</a></li>
                                    <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Identity/Account/Manage">@Localize("Account")</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="@WikiConfiguration.BasePath/Identity/Account/Logout">@Localize("Logout")</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@WikiConfiguration.BasePath/Identity/Account/Login?returnUrl=@UrlEncoder.Default.Encode($"{WikiConfiguration.BasePath}{Context.Request.Path.Value}")">
                                    @Localize("Login")
                                </a>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="themeToggle" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Localize("Theme")" aria-label="@Localize("Theme")">
                                <i id="themeToggleIcon" class="bi bi-circle-half"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="themeToggle">
                                <li><button type="button" class="dropdown-item" data-theme-choice="auto" onclick="twTheme.set('auto')"><i class="bi bi-circle-half me-2"></i>@Localize("Auto")</button></li>
                                <li><button type="button" class="dropdown-item" data-theme-choice="light" onclick="twTheme.set('light')"><i class="bi bi-sun-fill me-2"></i>@Localize("Light")</button></li>
                                <li><button type="button" class="dropdown-item" data-theme-choice="dark" onclick="twTheme.set('dark')"><i class="bi bi-moon-stars-fill me-2"></i>@Localize("Dark")</button></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@WikiConfiguration.BasePath/Page/Localization" title="@Localize("Language")">
                                @CultureInfo.CurrentCulture.Name.ToUpperInvariant()
                            </a>
                        </li>
                    </ul>

                    @if (WikiConfiguration.IncludeSearchOnNavbar)
                    {
                        <form class="d-flex ms-sm-3 mt-2 mt-sm-0" role="search" method="get" action="@WikiConfiguration.BasePath/Page/Search">
                            <input class="form-control me-2"
                                   type="search"
                                   placeholder="@Localize("Search text")"
                                   name="SearchString"
                                   aria-label="@Localize("Search")" />
                            <button class="btn btn-outline-primary" type="submit">
                                @Localize("Search")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div id="mainContainer" class="container mt-3">
        <main role="main" class="pb-3">
            @Html.Raw(WikiConfiguration.HTMLPreBody)

            @if (await UsersRepository.AdminPasswordStatus() != TwAdminPasswordChangeState.HasBeenChanged)
            {
                <div class="card shadow-sm border-warning mb-3">
                    <div class="card-header bg-warning-subtle border-warning">
                        <div class="fw-semibold">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Localize("Default password has not been changed")
                        </div>
                    </div>
                    <div class="card-body">
                        <strong>@Localize("Current admin login"):</strong><br />
                        <span class="ms-3"><strong>@Localize("Username"):</strong> "admin@tightwiki.com"</span><br />
                        <span class="ms-3"><strong>@Localize("Password"):</strong> "@Constants.DEFAULTPASSWORD"</span>
                    </div>
                </div>
            }

            @{
                //Messages come from the model, or from TempData after a redirect. They are never read from the
                //  query string, and are always rendered as text (line breaks are preserved by "tw-message").
                string? successMessage = TempData["SuccessMessage"] as string ?? (string?)Model?.SuccessMessage;
                string? warningMessage = TempData["WarningMessage"] as string ?? (string?)Model?.WarningMessage;
                string? errorMessage = TempData["ErrorMessage"] as string ?? (string?)Model?.ErrorMessage;
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show auto-dismiss-alert" role="alert">
                    <div class="fw-semibold tw-message">@successMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localize("Close")"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(warningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <div class="fw-semibold tw-message">@warningMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localize("Close")"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <div class="fw-semibold tw-message">@errorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localize("Close")"></button>
                </div>
            }

            @RenderBody()

            @Html.Raw(WikiConfiguration.HTMLPostBody)
        </main>
    </div>

    <footer class="container pb-4">
        @if (WikiConfiguration.FooterBlurb != null || WikiConfiguration.Copyright != null)
        {
            <hr class="mt-5 mb-4" />
            @if (WikiConfiguration.FooterBlurb != null)
            {
                var state = await TightEngine.Transform(Localizer, sessionState, WikiConfiguration.FooterBlurb);
                <div class="mb-2">
                    @Html.Raw(state.HtmlResult)
                </div>
            }

            @if (WikiConfiguration.Copyright != null)
            {
                <div class="text-muted small">
                    @Html.Raw(WikiConfiguration.Copyright)
                </div>
            }
        }

        @Html.Raw(WikiConfiguration.HTMLFooter)
    </footer>
</body>
</html>
