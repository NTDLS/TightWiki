@using System.Globalization
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@using TightWiki
@using TightWiki.Library
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Interfaces.Repository
@using static TightWiki.Plugin.TwConstants
@inject ITwSharedLocalizationText Localizer
@inject ITwEngine TightEngine
@inject TwConfiguration WikiConfiguration
@inject ITwUsersRepository UsersRepository
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion

@{
    var sessionState = ViewData["SessionState"] as TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");

    var theme = sessionState.UserTheme;
    string navBarClass = $"navbar navbar-expand-lg tw-navbar {(WikiConfiguration.FixedMenuPosition ? "sticky-top" : "")} {theme.ClassNavBar} border-bottom shadow-sm";
    var isPageProtected = sessionState.PageInstructions.Contains(TwInstruction.Protect);
}

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(sessionState.PageTitle ?? sessionState.Page.Name)</title>

    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")">
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32.png")">
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16.png")">

    @if (!string.IsNullOrWhiteSpace(WikiConfiguration.HTMLHeader))
    {
        @Html.Raw(WikiConfiguration.HTMLHeader)
    }

    @if (WikiConfiguration.IncludeWikiDescriptionInMeta)
    {
        <meta name="description" content="@sessionState.Page.Description">
    }

    @if (WikiConfiguration.IncludeWikiTagsInMeta)
    {
        <meta name="keywords" content="@sessionState.PageTags">
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/themes/base/jquery-ui.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/css/tabulator.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />

    @if (sessionState.UserTheme.EditorTheme == "dark")
    {
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/css/tabulator_midnight.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    }

    @foreach (var file in sessionState.UserTheme.Files)
    {
        if (file.StartsWith("http://", StringComparison.InvariantCultureIgnoreCase) || file.StartsWith("https://", StringComparison.InvariantCultureIgnoreCase))
        {
            <link rel="stylesheet" href="@file" />
        }
        else
        {
            <link rel="stylesheet" href="@Url.Content($"~{file}")" />
        }
    }

    @* The version hash makes browsers fetch the stylesheet again whenever it changes. *@
    <link rel="stylesheet" href="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/css/base.css"))" />

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jqueryui/1.14.1/jquery-ui.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/js/select2.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.7/js/bootstrap.bundle.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tabulator/6.3.1/js/tabulator.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <script>
        localStorage.setItem('theme', @Json.Serialize(sessionState.UserTheme.EditorTheme));
        window.twText = @Json.Serialize(new
        {
            confirmTitle = Localizer["Are you sure?"].Value,
            yes = Localizer["Yes"].Value,
            no = Localizer["No"].Value,
            close = Localizer["Close"].Value
        });
    </script>
    <script src="@FileVersion.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/site.js"))"></script>

    @RenderSection("Scripts", required: false)
</head>

<body>
    <header>
        <nav class="@navBarClass">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" href="@WikiConfiguration.BasePath/">
                    <span class="site-branding d-inline-flex align-items-center gap-2 @theme.ClassBranding">
                        <img src="@Url.Content(WikiConfiguration.BrandImageSmall)"
                             alt="@WikiConfiguration.Name"
                             style="max-height: 28px;" />
                        <span>@WikiConfiguration.Name</span>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-sm-0">

                        @foreach (var item in WikiConfiguration.MenuItems)
                        {
                            if (item.Link.StartsWith("http://", StringComparison.InvariantCultureIgnoreCase) ||
                                item.Link.StartsWith("https://", StringComparison.InvariantCultureIgnoreCase))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @theme.ClassNavLink" href="@item.Link" target="_blank" rel="noopener">
                                        @Localizer[item.Name]
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link @theme.ClassNavLink" href="@WikiConfiguration.BasePath@item.Link">
                                        @Localizer[item.Name]
                                    </a>
                                </li>
                            }
                        }

                        @if (await sessionState.HoldsPermission(TwPermission.Create)
                                                    || (sessionState.ShouldCreatePage && await sessionState.HoldsPermission(TwPermission.Create))
                                                    || (sessionState.Page.Exists && await sessionState.HoldsPermission([TwPermission.Edit, TwPermission.Moderate, TwPermission.Delete])))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @theme.ClassNavLink" href="#" id="pageMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["Page"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="pageMenuDropdown">
                                    @{
                                        bool canRead = await sessionState.HoldsPermission(TwPermission.Read);
                                        bool canCreate = await sessionState.HoldsPermission(TwPermission.Create);
                                        bool canEdit = !sessionState.Page.IsHistoricalVersion
                                            && ((!isPageProtected && await sessionState.HoldsPermission(TwPermission.Edit))
                                                || (isPageProtected && await sessionState.HoldsPermission(TwPermission.Moderate)));
                                        //Protected pages can not be deleted until their protection is removed.
                                        bool canDelete = !sessionState.Page.IsHistoricalVersion && !isPageProtected
                                            && await sessionState.HoldsPermission(TwPermission.Delete);
                                        bool canRevert = sessionState.Page.IsHistoricalVersion && await sessionState.HoldsPermission(TwPermission.Moderate);
                                        string pageUrl = $"{WikiConfiguration.BasePath}/{sessionState.PageNavigation}";
                                    }

                                    @if (sessionState.Page.Exists)
                                    {
                                        if (canRead)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl">@Localizer["View"]</a></li>
                                        }
                                        if (canEdit)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Edit">@Localizer["Edit"]</a></li>
                                        }
                                        if (canRead && WikiConfiguration.EnablePageComments)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Comments">@Localizer["Comments"]</a></li>
                                        }
                                        if (canRead)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Revisions">@Localizer["Revisions"]</a></li>
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Export">@Localizer["Export"]</a></li>
                                        }
                                        if (canCreate)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Refresh">@Localizer["Refresh"]</a></li>
                                        }
                                        if (canRevert)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/revert/@sessionState.Page.Revision">@Localizer.Format("Revert to revision {0}", sessionState.Page.Revision)</a></li>
                                        }
                                    }

                                    @if (canCreate)
                                    {
                                        if (sessionState.Page.Exists)
                                        {
                                            <li><hr class="dropdown-divider"></li>
                                        }
                                        if (sessionState.ShouldCreatePage)
                                        {
                                            <li><a class="dropdown-item @theme.ClassDropdown" href="@pageUrl/Create">@Localizer.Format("Create \"{0}\"", sessionState.PageNavigation)</a></li>
                                        }
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Page/Create">@Localizer["Create new page"]</a></li>
                                    }

                                    @if (sessionState.Page.Exists && canDelete)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="@pageUrl/Delete">@Localizer["Delete this page"]</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (sessionState.IsAuthenticated && await sessionState.HoldsPermission(TwPermission.Moderate))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @theme.ClassNavLink" href="#" id="adminMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["Admin"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminMenuDropdown">
                                    @if (sessionState.IsAdministrator)
                                    {
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/AdminSecurity/Accounts">@Localizer["Accounts"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/AdminSecurity/Roles">@Localizer["Roles"]</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Config">@Localizer["Configuration"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Plugins">@Localizer["Plugins"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Emojis">@Localizer["Emojis"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/MenuItems">@Localizer["Site Menu"]</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/PageStatistics">@Localizer["Page Statistics"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Database">@Localizer["Database"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/EventLog">@Localizer["Event Log"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Metrics">@Localizer["Metrics"]</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/DeletedPages">@Localizer["Deleted Pages"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/MissingPages">@Localizer["Missing Pages"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Moderate">@Localizer["Moderate"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Namespaces">@Localizer["Namespaces"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/OrphanedPageAttachments">@Localizer["Orphaned Attachments"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Pages">@Localizer["Pages"]</a></li>
                                    }
                                    else
                                    {
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/DeletedPages">@Localizer["Deleted Pages"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/MissingPages">@Localizer["Missing Pages"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Moderate">@Localizer["Moderate"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Namespaces">@Localizer["Namespaces"]</a></li>
                                        <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Admin/Pages">@Localizer["Pages"]</a></li>
                                    }
                                </ul>
                            </li>
                        }

                        @if (sessionState.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @theme.ClassNavLink" href="#" id="myMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @Localizer["My"]
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="myMenuDropdown">
                                    <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Profile/My">@Localizer["Profile"]</a></li>
                                    <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Identity/Account/Manage">@Localizer["Account"]</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item @theme.ClassDropdown" href="@WikiConfiguration.BasePath/Identity/Account/Logout">@Localizer["Logout"]</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @theme.ClassNavLink" href="@WikiConfiguration.BasePath/Identity/Account/Login?returnUrl=@UrlEncoder.Default.Encode($"{WikiConfiguration.BasePath}{Context.Request.Path.Value}")">
                                    @Localizer["Login"]
                                </a>
                            </li>
                        }

                        <li class="nav-item">
                            <a class="nav-link @theme.ClassNavLink" href="@WikiConfiguration.BasePath/Page/Localization" title="@Localizer["Language"]">
                                @CultureInfo.CurrentCulture.Name.ToUpperInvariant()
                            </a>
                        </li>
                    </ul>

                    @if (WikiConfiguration.IncludeSearchOnNavbar)
                    {
                        <form class="d-flex ms-sm-3 mt-2 mt-sm-0" role="search" method="get" action="@WikiConfiguration.BasePath/Page/Search">
                            <input class="form-control me-2"
                                   type="search"
                                   placeholder="@Localizer["Search text"]"
                                   name="SearchString"
                                   aria-label="@Localizer["Search"]" />
                            <button class="btn btn-outline-primary" type="submit">
                                @Localizer["Search"]
                            </button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div id="mainContainer" class="container mt-3">
        <main role="main" class="pb-3">
            @Html.Raw(WikiConfiguration.HTMLPreBody)

            @if (await UsersRepository.AdminPasswordStatus() != TwAdminPasswordChangeState.HasBeenChanged)
            {
                <div class="card shadow-sm border-warning mb-3">
                    <div class="card-header bg-warning-subtle border-warning">
                        <div class="fw-semibold text-dark">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@Localizer["Default password has not been changed"]
                        </div>
                    </div>
                    <div class="card-body">
                        <strong>@Localizer["Current admin login"]:</strong><br />
                        <span class="ms-3"><strong>@Localizer["Username"]:</strong> "admin@tightwiki.com"</span><br />
                        <span class="ms-3"><strong>@Localizer["Password"]:</strong> "@Constants.DEFAULTPASSWORD"</span>
                    </div>
                </div>
            }

            @{
                //Messages come from the model, or from TempData after a redirect. They are never read from the
                //  query string, and are always rendered as text (line breaks are preserved by "tw-message").
                string? successMessage = TempData["SuccessMessage"] as string ?? (string?)Model?.SuccessMessage;
                string? warningMessage = TempData["WarningMessage"] as string ?? (string?)Model?.WarningMessage;
                string? errorMessage = TempData["ErrorMessage"] as string ?? (string?)Model?.ErrorMessage;
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show auto-dismiss-alert" role="alert">
                    <div class="fw-semibold tw-message">@successMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(warningMessage))
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <div class="fw-semibold tw-message">@warningMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <div class="fw-semibold tw-message">@errorMessage</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Localizer["Close"]"></button>
                </div>
            }

            @RenderBody()

            @Html.Raw(WikiConfiguration.HTMLPostBody)
        </main>
    </div>

    <footer class="container pb-4">
        @if (WikiConfiguration.FooterBlurb != null || WikiConfiguration.Copyright != null)
        {
            <hr class="mt-5 mb-4" />
            @if (WikiConfiguration.FooterBlurb != null)
            {
                var state = await TightEngine.Transform(Localizer, sessionState, WikiConfiguration.FooterBlurb);
                <div class="mb-2">
                    @Html.Raw(state.HtmlResult)
                </div>
            }

            @if (WikiConfiguration.Copyright != null)
            {
                <div class="text-muted small">
                    @Html.Raw(WikiConfiguration.Copyright)
                </div>
            }
        }

        @Html.Raw(WikiConfiguration.HTMLFooter)
    </footer>
</body>
</html>
