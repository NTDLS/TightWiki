@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.Utility
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model NotifyViewModel
@{
    Layout = "_Layout";

    bool hasRedirect = !string.IsNullOrEmpty(Model.RedirectURL);
    bool autoRedirect = hasRedirect
        && string.IsNullOrEmpty(Model.NotifyErrorMessage)
        && string.IsNullOrEmpty(Model.NotifyWarningMessage)
        && Model.RedirectTimeout > 0;

    //All messages are rendered as text: the first line is the headline and any further lines are details.
    var alerts = new List<(string Class, string Message)>();
    if (!string.IsNullOrEmpty(Model.NotifyErrorMessage)) alerts.Add(("alert-danger", Model.NotifyErrorMessage));
    if (!string.IsNullOrEmpty(Model.NotifyWarningMessage)) alerts.Add(("alert-warning", Model.NotifyWarningMessage));
    if (!string.IsNullOrEmpty(Model.NotifySuccessMessage)) alerts.Add(("alert-success", Model.NotifySuccessMessage));
}

@if (autoRedirect)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var countdownElement = document.getElementById('countdown');
            var countdownTime = @(Model.RedirectTimeout - 1);

            var interval = setInterval(function () {
                countdownElement.textContent = countdownTime;
                countdownTime--;

                if (countdownTime < 0) {
                    clearInterval(interval);
                    window.location.href = @Json.Serialize(Model.RedirectURL);
                }
            }, 1000);
        });
    </script>
}

@foreach (var (alertClass, message) in alerts)
{
    var lines = message.Replace("\r\n", "\n").Split('\n');

    <div class="alert @alertClass" role="alert">
        <strong>@lines[0]</strong>
        @if (lines.Length > 1)
        {
            <hr />
            <div class="tw-message">@string.Join("\n", lines.Skip(1))</div>
        }

        @if (hasRedirect)
        {
            <div class="mt-2">
                @if (autoRedirect)
                {
                    //Encode the translated sentence, then swap its placeholders for the link and countdown markup.
                    var sentence = System.Net.WebUtility.HtmlEncode(
                        Localizer.Format("{0}Continue now{1} or you will be redirected in {2} seconds.", "\u0001", "\u0002", "\u0003"));
                    @Html.Raw(sentence
                        .Replace("\u0001", $"<a href=\"{System.Net.WebUtility.HtmlEncode(Model.RedirectURL)}\">")
                        .Replace("\u0002", "</a>")
                        .Replace("\u0003", $"<span id=\"countdown\">{Model.RedirectTimeout}</span>"))
                }
                else
                {
                    <a href="@Model.RedirectURL">@Localizer["Continue"]</a>
                }
            </div>
        }
    </div>
}
