@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.File
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model FileAttachmentViewModel
@{
    //This is a fragment that the page editor loads into its attachment list, the editor's layout provides the styles and scripts.
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<script>
    function detachFile(fileName) {
        const message = @Json.Serialize(Localizer["Are you sure you want to detach \"{0}\"?"].Value);
        twConfirm(message.replace('{0}', fileName)).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            const pageNavigation = @Json.Serialize(Model.PageNavigation);
            $.ajax({
                type: 'POST',
                url: @Json.Serialize($"{WikiConfiguration.BasePath}/File/Detach/")
                    + encodeURIComponent(pageNavigation)
                    + '/' + encodeURIComponent(fileName)
                    + '/' + encodeURIComponent(@Json.Serialize(Model.PageRevision.ToString())),
                success: function () {
                    $("#uploadedFiles").load(@Json.Serialize($"{WikiConfiguration.BasePath}/File/PageAttachments/") + encodeURIComponent(pageNavigation));
                }
            });
        });
    }

    function copyToClipboard(fileName, element) {
        const ext = fileName.split('.').pop().toLowerCase();
        const isImage = ['png', 'jpg', 'jpeg', 'gif', 'bmp'].includes(ext);
        const tag = (isImage ? '##Image(' : '##File(') + fileName + ')';

        navigator.clipboard.writeText(tag).then(function () {
            const originalContent = element.innerHTML;
            const originalClass = element.className;

            element.innerHTML = '<i class="bi bi-check-circle me-1"></i>';
            element.append(@Json.Serialize(Localizer["Tag Copied"].Value));
            element.className = 'btn btn-thin btn-success';

            setTimeout(function () {
                element.innerHTML = originalContent;
                element.className = originalClass;
            }, 2000);
        }).catch(function (error) {
            console.error(@Json.Serialize(Localizer["Error copying text"].Value), error);
        });
    }
</script>

@foreach (var x in Model.Files)
{
    <div class="list-group-item d-flex justify-content-between align-items-center">
        <div class="ms-1 mb-1">
            <a href="@WikiConfiguration.BasePath/File/Binary/@x.PageNavigation/@x.FileNavigation" target="_blank">@x.Name</a> <span class="file-meta">(@x.FriendlySize)</span>
            <a href="@WikiConfiguration.BasePath/File/Revisions/@x.PageNavigation/@x.FileNavigation" target="_blank">@x.FileRevision @Localizer["revisions"]</a>
        </div>
        <div class="d-inline-flex gap-1">
            <button type="button" class="btn btn-thin btn-primary" data-file="@x.Name" onclick="copyToClipboard(this.dataset.file, this)">
                <i class="bi bi-clipboard me-1"></i>@Localizer["Copy Tag"]
            </button>
            @if (await sessionState.HoldsPermission(TwPermission.Delete))
            {
                <button type="button" class="btn btn-thin btn-danger" data-file="@x.FileNavigation" onclick="detachFile(this.dataset.file)">@Localizer["Detach"]</button>
            }
        </div>
    </div>
}
