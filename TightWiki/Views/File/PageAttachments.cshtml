@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.File
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model FileAttachmentViewModel
@{
    //This is a fragment that the page editor loads into its attachment list, the editor's layout provides the styles and scripts.
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<script>
    function detachFile(fileName) {
        const message = @Json.Serialize(Localize("Are you sure you want to detach \"{0}\"?"));
        twConfirm(message.replace('{0}', fileName)).then(function (confirmed) {
            if (!confirmed) {
                return;
            }
            const pageNavigation = @Json.Serialize(Model.PageNavigation);
            $.ajax({
                type: 'POST',
                url: @Json.Serialize($"{WikiConfiguration.BasePath}/File/Detach/")
                    + encodeURIComponent(pageNavigation)
                    + '/' + encodeURIComponent(fileName)
                    + '/' + encodeURIComponent(@Json.Serialize(Model.PageRevision.ToString())),
                success: function () {
                    $("#uploadedFiles").load(@Json.Serialize($"{WikiConfiguration.BasePath}/File/PageAttachments/") + encodeURIComponent(pageNavigation));
                }
            });
        });
    }

    function copyToClipboard(fileName, contentType, element) {
        //The editor loads attachment-uploader.js, which chooses ##Image, ##Video, ##Audio or ##File from the file's type.
        copyText(TwAttachmentUploader.tagFor(fileName, contentType), @Json.Serialize(Localize("Tag Copied")), element);
    }

    //Just the name, for use inside another function, such as a video's poster.
    function copyName(fileName, element) {
        copyText(fileName, @Json.Serialize(Localize("Name Copied")), element);
    }

    function copyText(text, copiedLabel, element) {
        navigator.clipboard.writeText(text).then(function () {
            //Keep the button's own look the first time, so clicking again while it says "Copied" restores it correctly.
            if (!element.dataset.originalContent) {
                element.dataset.originalContent = element.innerHTML;
                element.dataset.originalClass = element.className;
            }
            clearTimeout(element.copiedTimer);

            element.innerHTML = '<i class="bi bi-check-circle me-1"></i>';
            element.append(copiedLabel);
            element.className = 'btn btn-thin btn-success';

            element.copiedTimer = setTimeout(function () {
                element.innerHTML = element.dataset.originalContent;
                element.className = element.dataset.originalClass;
            }, 2000);
        }).catch(function (error) {
            console.error(@Json.Serialize(Localize("Error copying text")), error);
        });
    }
</script>

@foreach (var x in Model.Files)
{
    <div class="list-group-item d-flex justify-content-between align-items-center">
        <div class="ms-1 mb-1">
            <a href="@WikiConfiguration.BasePath/File/Binary/@x.PageNavigation/@x.FileNavigation" target="_blank">@x.Name</a> <span class="file-meta">(@x.FriendlySize)</span>
            <a href="@WikiConfiguration.BasePath/File/Revisions/@x.PageNavigation/@x.FileNavigation" target="_blank">@x.FileRevision @Localize("revisions")</a>
        </div>
        <div class="d-inline-flex gap-1 flex-shrink-0 text-nowrap">
            <div class="btn-group" role="group" aria-label="@Localize("Copy")">
                <button type="button" class="btn btn-thin btn-primary" data-file="@x.Name" data-content-type="@x.ContentType" onclick="copyToClipboard(this.dataset.file, this.dataset.contentType, this)"
                        title="@Localize("Copy the wiki function that shows this file")">
                    <i class="bi bi-clipboard me-1"></i>@Localize("Copy Tag")
                </button>
                @* The divider shows where one button ends, both halves are the same color. *@
                <button type="button" class="btn btn-thin btn-primary" style="border-left-color: rgba(255, 255, 255, 0.45);" data-file="@x.Name" onclick="copyName(this.dataset.file, this)"
                        title="@Localize("Copy just the file name, for example to use as a video's poster")">
                    <i class="bi bi-clipboard me-1"></i>@Localize("Copy Name")
                </button>
            </div>
            @if (await sessionState.HoldsPermission(TwPermission.Delete))
            {
                <button type="button" class="btn btn-thin btn-danger" data-file="@x.FileNavigation" onclick="detachFile(this.dataset.file)">@Localize("Detach")</button>
            }
        </div>
    </div>
}
