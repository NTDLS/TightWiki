@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.AdminSecurity
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model AddRoleViewModel
@{
    Layout = "_Layout";
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">
            @Localize("Add Role")
        </h3>
        <div class="text-muted">
            @Localize("Create new role.")
        </div>
    </div>
</div>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fw-semibold">
                <i class="bi bi-shield-plus me-2"></i>@Localize("New Role")
            </span>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-floppy me-1"></i>@Localize("Save")
            </button>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-12">
                    <label for="Name" class="form-label fw-semibold">
                        @Localize("Name")
                    </label>
                    @Html.TextBoxFor(m => m.Name, new
                    {
                        @class = "form-control",
                        placeholder= Localize("Required")
                    })
                    <div class="text-danger small">
                        @Html.ValidationMessageFor(m => m.Name)
                    </div>
                </div>

                <div class="col-12">
                    <label for="Description" class="form-label fw-semibold">
                        @Localize("Description")
                    </label>
                    @Html.TextBoxFor(m => m.Description, new
                    {
                        @class = "form-control",
                        placeholder= Localize("Optional")
                    })
                    <div class="text-danger small">
                        @Html.ValidationMessageFor(m => m.Description)
                    </div>
                </div>
            </div>
        </div>
    </div>
}