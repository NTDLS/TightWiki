@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.Profile
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model ApiTokensViewModel
@{
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">@Localize("API Tokens")</h3>
        <div class="text-muted">@Localize("Personal API tokens identify you without a password. Treat them like a password.")</div>
    </div>
    <a class="btn btn-outline-secondary" href="@WikiConfiguration.BasePath/Profile/My">
        <i class="bi bi-arrow-left me-1"></i>@Localize("Back to Profile")
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.NewToken))
{
    <div class="card shadow-sm border-success mb-3">
        <div class="card-header fw-semibold">
            <i class="bi bi-key me-2"></i>@Localize("Your new API token")
        </div>
        <div class="card-body">
            <div class="text-muted mb-2">@Localize("Copy the token now. It is shown only once and cannot be displayed again.")</div>
            <input type="text" class="form-control font-monospace" readonly value="@Model.NewToken" onfocus="this.select()" />
        </div>
    </div>
}

@using (Html.BeginForm(null, null, null, FormMethod.Post, true, new { action = $"{WikiConfiguration.BasePath}/Profile/ApiTokens" }))
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-semibold">
            <i class="bi bi-plus-circle me-2"></i>@Localize("Create Token")
        </div>
        <div class="card-body">
            <label for="Name" class="form-label fw-semibold">@Localize("Token Name")</label>
            <div class="d-flex flex-wrap gap-2">
                @Html.TextBoxFor(m => m.Name, new { @class = "form-control w-auto flex-grow-1", maxlength = 100 })
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-key me-1"></i>@Localize("Create")
                </button>
            </div>
            <div class="text-danger small">
                @Html.ValidationMessageFor(m => m.Name)
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-header fw-semibold">
        <i class="bi bi-list-ul me-2"></i>@Localize("Your Tokens")
    </div>

    @if (Model.Tokens.Count == 0)
    {
        <div class="card-body text-muted">@Localize("You have no API tokens.")</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">@Localize("Token Name")</th>
                        <th scope="col" class="text-nowrap">@Localize("Created Date")</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var token in Model.Tokens)
                    {
                        <tr>
                            <td>@token.Name</td>
                            <td class="text-nowrap">@token.CreatedDate</td>
                            <td class="text-end">
                                <form method="post" action="@WikiConfiguration.BasePath/Profile/ApiTokens/Revoke">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="tokenId" value="@token.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="bi bi-trash me-1"></i>@Localize("Revoke")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
