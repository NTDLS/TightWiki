@using TightWiki
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@using TightWiki.Plugin.Library
@using TightWiki.ViewModels.Profile
@inject ITwSharedLocalizationText Localizer
@inject TwConfiguration WikiConfiguration

@model ConfirmViewModel
@{
    Layout = "_Layout";
}
<div class="card shadow-lg">
    <div class="card-header">
        <h3>@Localize("Account Email Verification")</h3>
    </div>
    <div class="card-body">
        <p>
            @Localize("Already a member?") <a href="@WikiConfiguration.BasePath/Account/Login">@Localize("Login")</a>.<br />
            @Localize("Forgot your password?") @Html.ActionLink(Localize("Reset it"), "Forgot", "Account").<br />
        </p>
    </div>
</div>
