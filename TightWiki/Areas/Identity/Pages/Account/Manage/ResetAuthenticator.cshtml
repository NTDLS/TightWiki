@page
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@inject ITwSharedLocalizationText Localizer

@model ResetAuthenticatorModel
@{
    ViewData["Title"]= Localize("Reset authenticator key");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@Localize("If you reset your authenticator key your authenticator app will not work until you reconfigure it.")</strong>
    </p>
    <p>
        @Localize("This process disables 2FA until you verify your authenticator app. If you do not complete your authenticator app configuration you may lose access to your account.")
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">@Localize("Reset authenticator key")</button>
    </form>
</div>
