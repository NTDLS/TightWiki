@page
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@inject ITwSharedLocalizationText Localizer

@model GenerateRecoveryCodesModel
@{
    ViewData["Title"]= Localize("Generate two-factor authentication (2FA) recovery codes");
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>@Localize("Put these codes in a safe place.")</strong>
    </p>
    <p>
        @Localize("If you lose your device and don't have the recovery codes you will lose access to your account.")
    </p>
    <p>
        @Localize("Generating new recovery codes does not change the keys used in authenticator apps.")
        <a asp-page="./ResetAuthenticator">@Localize("If you wish to change the key used in an authenticator app you should reset your authenticator keys.")</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">@Localize("Generate Recovery Codes")</button>
    </form>
</div>
