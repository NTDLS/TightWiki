@page
@using System.Text.Encodings.Web
@using TightWiki.Plugin
@using TightWiki.Plugin.Interfaces
@inject ITwSharedLocalizationText Localizer

@model LdapLoginSupplementalModel
@{
    var sessionState = ViewData["SessionState"] as TightWiki.TwSessionState ?? throw new Exception("Wiki State Context cannot be null.");
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
    <div>
        <h3 class="mb-1">@Localize("Signup. Almost there...")</h3>
        <div class="text-muted">
            @Localize("You have successfully signed in with LDAP but we still need a bit of information.")
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 col-lg-10 col-xl-8">
        <div class="card shadow-sm">
            <div class="card-header">
                <span class="fw-semibold">
                    <i class="bi bi-person-check me-2"></i>@Localize("Complete Signup")
                </span>
            </div>

            <div class="card-body">
                <form asp-page-handler="Confirmation" asp-route-returnUrl="@UrlEncoder.Default.Encode(Model.ReturnUrl ?? "")" method="post">
                    @Html.HiddenFor(m => Model.UserId)

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label for="Input_AccountName" class="form-label fw-semibold">
                                @Localize("Display Name")
                            </label>
                            @Html.TextBoxFor(m => m.Input.AccountName, new
                            {
                                @class = "form-control",
                                placeholder = Localize("Required"),
                                id = "Input_AccountName"
                            })
                            <div class="form-text">
                                @Localize("This display name will be visible publicly.")
                            </div>
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.AccountName)
                            </div>
                        </div>

                        <div class="col-12">
                            <label for="Input_Email" class="form-label fw-semibold">
                                @Localize("Email Address")
                            </label>
                            @Html.TextBoxFor(m => m.Input.Email, new
                            {
                                @class = "form-control",
                                placeholder = "name@example.com",
                                id = "Input_Email",
                                autocomplete = "email"
                            })
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.Email)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="Input_FirstName" class="form-label fw-semibold">
                                @Localize("First Name")
                            </label>
                            @Html.TextBoxFor(m => m.Input.FirstName, new
                            {
                                @class = "form-control",
                                placeholder = Localize("Optional"),
                                id = "Input_FirstName"
                            })
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.FirstName)
                            </div>
                        </div>

                        <div class="col-12 col-md-6">
                            <label for="Input_LastName" class="form-label fw-semibold">
                                @Localize("Last Name")
                            </label>
                            @Html.TextBoxFor(m => m.Input.LastName, new
                            {
                                @class = "form-control",
                                placeholder = Localize("Optional"),
                                id = "Input_LastName"
                            })
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.LastName)
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="Input_Country" class="form-label fw-semibold">
                                @Localize("Country")
                            </label>
                            <select name="Input.Country" id="Input_Country" class="form-select">
                                <option value="">@Localize("Select a country")</option>
                                @foreach (var item in Model.Input.Countries)
                                {
                                    <option value="@item.Value" selected="@(Model.Input.Country == item.Value ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.Country)
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="Input_Language" class="form-label fw-semibold">
                                @Localize("Language")
                            </label>
                            <select name="Input.Language" id="Input_Language" class="form-select">
                                <option value="">@Localize("Select a language")</option>
                                @foreach (var item in Model.Input.Languages)
                                {
                                    <option value="@item.Value" selected="@(Model.Input.Language == item.Value ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.Language)
                            </div>
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="Input_TimeZone" class="form-label fw-semibold">
                                @Localize("Time Zone")
                            </label>
                            <select name="Input.TimeZone" id="Input_TimeZone" class="form-select">
                                <option value="">@Localize("Select a time-zone")</option>
                                @foreach (var item in Model.Input.TimeZones)
                                {
                                    <option value="@item.Value" selected="@(Model.Input.TimeZone == item.Value ? "selected" : null)">
                                        @item.Text
                                    </option>
                                }
                            </select>
                            <div class="text-danger small">
                                @Html.ValidationMessageFor(m => m.Input.TimeZone)
                            </div>
                        </div>

                        <div class="col-12">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="bi bi-person-check me-1"></i>@Localize("Complete Signup")
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
