@page
@using TightWiki.Plugin.Interfaces
@inject ITwSharedLocalizationText Localizer

@model ErrorModel
@{
    ViewData["Title"]= Localize("Error");
}

<h1 class="text-danger">@Localize("Error").</h1>
<h2 class="text-danger">@Localize("An error occurred while processing your request.")</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localize("Request ID"):</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localize("Development Mode")</h3>
<p>
    @Localize("Swapping to the <strong>Development</strong> environment displays detailed information about the error that occurred.")
</p>
<p>
    <strong>@Localize("The Development environment shouldn't be enabled for deployed applications.")</strong>
    @Localize("It can result in displaying sensitive information from exceptions to end users.")
</p>
