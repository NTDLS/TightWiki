@page "/search"
@rendermode InteractiveServer
@inherits VisitorComponentBase

<PageTitle>Search - TightWiki Translations</PageTitle>

<div class="container py-4">
    <h1 class="h3 mb-3">Search translations</h1>

    <div class="card tw-card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-12 col-md">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="search" class="form-control" value="@query" placeholder="Any phrase, in any language..."
                               aria-label="Search" @oninput="OnQueryInput" @onchange="UpdateUrl" autofocus />
                    </div>
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <select class="form-select" aria-label="Language" value="@choice" @onchange="OnLanguageChanged">
                        <option value="all" selected="@(choice == "all")">All languages</option>
                        @if (Prefs.HasSelection)
                        {
                            <option value="mine" selected="@(choice == "mine")">My languages (@string.Join(", ", Prefs.Names))</option>
                        }
                        @foreach (var item in Catalog.Languages)
                        {
                            <option value="@item.Name" selected="@(item.Name == choice)">@item.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="small text-body-secondary mt-2">
                @if (results.Total == 0)
                {
                    <span>No phrases found.</span>
                }
                else
                {
                    <span>Showing @results.Items.Count.ToString("N0") of @results.Total.ToString("N0") phrases@(Scope).</span>
                }
            </div>
        </div>
    </div>

    @if (results.Items.Count == 0)
    {
        <div class="text-center text-body-secondary py-5">
            <i class="bi bi-search display-4"></i>
            <p class="mt-3 mb-1">Nothing matched <strong>@query</strong>.</p>
            <p class="small">Try fewer words, or search in a different language.</p>
        </div>
    }

    @foreach (var match in results.Items)
    {
        var phrase = match.Phrase;
        var phraseSuggestions = suggestionsByPhrase[phrase.English].ToList();

        <div class="card tw-card shadow-sm mb-3" @key="phrase.Key">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h2 class="tw-english h5 mb-2">@phrase.English</h2>
                    <span class="badge text-bg-light border flex-shrink-0">@phrase.Translations.Count / @Catalog.Languages.Count</span>
                </div>

                @if (ChoiceLanguages != null)
                {
                    foreach (var shown in ChoiceLanguages)
                    {
                        <TranslationRow Phrase="phrase" Language="@shown" Visitor="Visitor" />
                    }
                }
                else
                {
                    foreach (var matched in match.MatchedLanguages.Take(4))
                    {
                        <TranslationRow Phrase="phrase" Language="@matched" Visitor="Visitor" />
                    }
                }

                <details class="mt-2">
                    <summary class="small text-body-secondary">All @phrase.Translations.Count translations</summary>
                    <div class="tw-all-translations mt-2">
                        @foreach (var item in Catalog.Languages)
                        {
                            <TranslationRow Phrase="phrase" Language="@item.Name" Visitor="Visitor" />
                        }
                    </div>
                </details>

                @if (phraseSuggestions.Count > 0)
                {
                    <div class="tw-list tw-list-inset mt-3">
                        @foreach (var item in phraseSuggestions)
                        {
                            <SuggestionItem @key="item.Id" Item="item" Visitor="Visitor" ShowEnglish="false" />
                        }
                    </div>
                }

                <div class="mt-3">
                    @if (openForms.Contains(phrase.Key))
                    {
                        <SuggestForm Phrase="phrase" Visitor="Visitor" Language="@SingleLanguage" PreferredLanguages="Prefs.NamesOrNull" />
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => openForms.Add(phrase.Key)">
                            <i class="bi bi-lightbulb me-1"></i>Suggest a translation
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (results.Total > results.Items.Count)
    {
        <div class="text-center">
            <button type="button" class="btn btn-outline-secondary" @onclick="ShowMore">Show more</button>
        </div>
    }
</div>

@code {
    private const int PageSize = 20;

    [SupplyParameterFromQuery(Name = "q")] private string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "lang")] private string? Lang { get; set; }

    private string query = string.Empty;

    /// <summary>
    /// "all", "mine" (the languages the visitor has chosen), or the name of one language.
    /// </summary>
    private string choice = "all";

    private int take = PageSize;
    private SearchResults results = new(Array.Empty<PhraseMatch>(), 0);
    private ILookup<string, Suggestion> suggestionsByPhrase = Array.Empty<Suggestion>().ToLookup(o => o.English);
    private readonly HashSet<string> openForms = new();

    /// <summary>
    /// The languages that the search is limited to, or null for all of them.
    /// </summary>
    private IReadOnlyCollection<string>? ChoiceLanguages => choice switch
    {
        "all" => null,
        "mine" => Prefs.NamesOrNull,
        _ => new[] { choice }
    };

    private string? SingleLanguage => choice is "all" or "mine" ? null : choice;

    private string Scope => ChoiceLanguages == null ? string.Empty : $" in {string.Join(", ", ChoiceLanguages)}";

    /// <summary>
    /// What a "lang" in the address means. Without one, a visitor who has chosen their languages gets those.
    /// </summary>
    private string Resolve(string? lang)
    {
        var fallback = Prefs.HasSelection ? "mine" : "all";

        if (string.IsNullOrWhiteSpace(lang))
        {
            return fallback;
        }

        if (lang.Equals("all", StringComparison.OrdinalIgnoreCase))
        {
            return "all";
        }

        if (lang.Equals("mine", StringComparison.OrdinalIgnoreCase))
        {
            return fallback;
        }

        return Catalog.FindLanguage(lang)?.Name ?? fallback;
    }

    protected override async Task OnInitializedAsync()
    {
        Prefs.EnsureInitialized();
        query = Q ?? string.Empty;
        choice = Resolve(Lang);
        await base.OnInitializedAsync();
    }

    protected override void OnParametersSet()
    {
        //Handles the visitor following a link (such as "Suggest" on the home page) while this page is already open.
        var newQuery = Q ?? string.Empty;
        var newChoice = Resolve(Lang);

        if (newQuery != query || newChoice != choice)
        {
            query = newQuery;
            choice = newChoice;
            take = PageSize;
            _ = LoadAsync();
        }
    }

    protected override Task LoadAsync()
    {
        //Their languages may have been cleared while this page was open.
        if (choice == "mine" && !Prefs.HasSelection)
        {
            choice = "all";
        }

        results = Catalog.SearchIn(query, ChoiceLanguages, 0, take);

        suggestionsByPhrase = Suggestions
            .GetForPhrasesIn(Visitor.QueryId, results.Items.Select(o => o.Phrase.English).ToList(), ChoiceLanguages)
            .ToLookup(o => o.English, StringComparer.OrdinalIgnoreCase);

        return Task.CompletedTask;
    }

    private async Task OnQueryInput(ChangeEventArgs args)
    {
        query = args.Value?.ToString() ?? string.Empty;
        take = PageSize;
        await LoadAsync();
    }

    private async Task OnLanguageChanged(ChangeEventArgs args)
    {
        choice = Resolve(args.Value?.ToString());
        take = PageSize;
        await LoadAsync();
        UpdateUrl();
    }

    /// <summary>
    /// Keeps the address in step with the search, so that a search can be shared or bookmarked.
    /// </summary>
    private void UpdateUrl()
    {
        Nav.NavigateTo(Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["q"] = string.IsNullOrWhiteSpace(query) ? null : query,
            ["lang"] = choice == Resolve(null) ? null : choice
        }), replace: true);
    }

    private async Task ShowMore()
    {
        take += PageSize;
        await LoadAsync();
    }
}
